<Window x:Class="CardputerCreoView.Bridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cardputer Creo Bridge" Width="650" Height="700"
        MinWidth="520" MinHeight="520" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Cardputer Creo Bridge" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText" Text="未连接" Margin="0,6,0,18" Foreground="#555" />
        </StackPanel>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
            <Button x:Name="ConnectButton" Content="连接" Click="ConnectButton_Click" Margin="0,0,6,0" Padding="8" />
            <Button x:Name="DisconnectButton" Content="断开" Click="DisconnectButton_Click" Margin="0,0,6,0" Padding="8" />
            <Button x:Name="CalibrateButton" Content="校准" Click="CalibrateButton_Click" Padding="8" />
        </UniformGrid>
        <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,18">
            <CheckBox x:Name="OutputCheckBox" Content="启用运动输出" VerticalContentAlignment="Center"
                      Checked="OutputCheckBox_Changed" Unchecked="OutputCheckBox_Changed" />
            <Button x:Name="RecenterButton" Content="重新锚定 (R)" Click="RecenterButton_Click" Margin="12,0,0,0" Padding="8" />
        </UniformGrid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="BLE" Foreground="#666" />
            <TextBlock x:Name="BleText" Grid.Row="0" Grid.Column="1" Text="未连接" />
            <TextBlock Grid.Row="1" Text="校准" Foreground="#666" />
            <TextBlock x:Name="CalibrationText" Grid.Row="1" Grid.Column="1" Text="未校准" />
            <TextBlock Grid.Row="2" Text="输出" Foreground="#666" />
            <TextBlock x:Name="OutputText" Grid.Row="2" Grid.Column="1" Text="关闭" />
            <TextBlock Grid.Row="3" Text="抓取" Foreground="#666" />
            <TextBlock x:Name="GrabText" Grid.Row="3" Grid.Column="1" Text="松手" />
            <TextBlock Grid.Row="4" Text="丢包" Foreground="#666" />
            <TextBlock x:Name="DroppedText" Grid.Row="4" Grid.Column="1" Text="0" />
            <TextBlock Grid.Row="5" Text="频率" Foreground="#666" />
            <TextBlock x:Name="RateText" Grid.Row="5" Grid.Column="1" Text="0.0 Hz" />
            <TextBlock Grid.Row="6" Text="UDP" Foreground="#666" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="127.0.0.1:49250" />
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock x:Name="SensorText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
            <TextBlock x:Name="RotationText" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock Text="轴映射：默认排列（待实机标定）" Foreground="#9A5B00" Margin="0,10,0,0" TextWrapping="Wrap" />
            <TextBlock Text="BMI270 无磁力计，Yaw 仅供抓取间相对使用" Foreground="#666" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="MessageText" Grid.Row="5" Margin="0,18,0,0" VerticalAlignment="Bottom"
                   Foreground="#A33" TextWrapping="Wrap" />
    </Grid>
    </ScrollViewer>
</Window>
